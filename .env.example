# Copy to .env and fill in. NEVER commit .env
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Key that clients must send in the x-api-key header of YOUR backend
API_KEY=change-me-to-a-long-random-string

# Exactly the browser origins allowed by CORS (max 2)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Refuse any request whose prompt is above this many tokens
MAX_INPUT_TOKENS=4000

# true  = fake LLM (no keys, no cost, same output format)
# false = real OpenAI. Leave empty: mock is used automatically when OPENAI_API_KEY is empty
USE_MOCK_LLM=
